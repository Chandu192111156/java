import java.util.Scanner;
 class Decrease {
	public static void accept_value(){
		System.out.println("Enter the number upto you want to print ");
		Scanner s=new Scanner(System.in);
		int a=s.nextInt();
		for(int i=a;i>1;i--){
			while(i%2==0){
		System.out.println(i);

	}
}
	public static void main(String[] args) 
	{
		accept_value();
					}
			}
 }