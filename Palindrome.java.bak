import java.util.Scanner;
class Palindrome 
{
	public static void main(String[] args) 
	{ 
		//Scanner s=new Scanner(System.in);
		//System.out.println("Enter number");
	
		for(int i=1;i<=100;i++){
			int num=i;
		int temp=num;
		int rev=0;
		while(num!=0){
			int end=num%10;
			rev=rev*10+end;
			num/=10;
	}
	if(rev==temp){
		System.out.println(rev);
            }
		}
	}
}