import java.util.Scanner;
class  positive
{
	public static void main(String[] args) 
	{
		Scanner s=new Scanner(System.in);
		System.out.println("Enter a numbers");
		int a=s.nextInt(); 
		int b=s.nextInt();
		int res=a>0? a+"is positive":b+"is not positive";
		System.out.println(res);
	}
}
